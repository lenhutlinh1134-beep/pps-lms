# ==== Supabase ====
# Lấy 2 giá trị này tại: Supabase Dashboard > Project Settings > API
# Sao chép file này thành ".env.local" rồi điền giá trị thật. KHÔNG commit .env.local lên git.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ==== Audio Storage (Production) ====
# Khi deploy Vercel: upload thư mục public/audio/ lên Supabase Storage bucket tên "audio" (public bucket)
# Sau đó set biến này = URL gốc của bucket. Ví dụ:
# NEXT_PUBLIC_AUDIO_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/audio
# Khi để trống (dev local): audio sẽ đọc từ /public/audio/ (không cần upload)
NEXT_PUBLIC_AUDIO_BASE_URL=
